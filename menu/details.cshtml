@model FoodHub.Models.Food

@{
    ViewBag.Title = "Food Details";
}

<h2>🍽️ Food Details</h2>

<hr />

<div class="panel panel-default">

    <div class="panel-heading">

        <h3>@Model.Name</h3>

    </div>

    <div class="panel-body">

        <p>
            <b>Category:</b>
            @Model.Category
        </p>

        <p>
            <b>Description:</b>
            @Model.Description
        </p>

        <p>
            <b>Price:</b>
            ₹@Model.Price
        </p>

        <a href="@Url.Action("Index", "Menu")"
           class="btn btn-primary">

            Back to Menu

        </a>

    </div>

</div>
